# Backend settings (configure secrets in Render, never commit real credentials)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
MONGODB_DATABASE=medicare360
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
CORS_ALLOWED_ORIGINS=https://medplus360.netlify.app

# Optional password recovery email settings
RESEND_API_KEY=
MAIL_FROM=
FRONTEND_URL=https://medplus360.netlify.app

# Netlify frontend build setting; use the Render API URL
VITE_API_BASE_URL=https://<your-render-service>.onrender.com/api/v1
