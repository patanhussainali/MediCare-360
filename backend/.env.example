# MediCare360 Backend Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets to Git.

PROJECT_NAME=MediCare360 Hospital Management Platform
API_V1_STR=/api/v1
ENVIRONMENT=development

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-random-secret-key-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Default: Local SQLite for development
DATABASE_URL=sqlite:///./medicare360.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/medicare360

# Redis Cache / Token Blacklist (Optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
# In production, add your Netlify frontend URL:
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://your-frontend.netlify.app"]

# Initial Master Administrator Seed (optional)
# If set, backend seeds this admin on startup if no admin exists.
# If left empty, use POST /api/v1/auth/setup-admin to create the first admin.
FIRST_SUPERUSER_EMAIL=admin@your-hospital.com
FIRST_SUPERUSER_PASSWORD=your-strong-admin-password
FIRST_SUPERUSER_NAME=Hospital Administrator

# MongoDB (optional — for additional collections)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/

# Railway Deployment Notes:
# - Railway auto-injects PORT and DATABASE_URL (if PostgreSQL plugin added)
# - Set ENVIRONMENT=production
# - Set SECRET_KEY to a secure random string
