# MediCare-360 — Environment Configuration Example
# Copy this file to .env and configure for your environment.
# NEVER commit the actual .env file with production credentials to Git.

# Application Settings
PROJECT_NAME=MediCare360 Hospital Management Platform
API_V1_STR=/api/v1
ENVIRONMENT=production

# Security — Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-random-secret-key-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Railway automatically injects DATABASE_URL when PostgreSQL plugin is added)
# Development (SQLite):
# DATABASE_URL=sqlite:///./medicare360.db
# Production (PostgreSQL):
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Optional Redis Cache / Token Blacklist (falls back to memory if unset)
# REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins
# Add your deployed Netlify/Railway frontend URLs:
BACKEND_CORS_ORIGINS=["http://localhost:5173","https://your-hospital.netlify.app","https://your-frontend.up.railway.app"]

# Initial Superuser Seed (optional)
# If provided, the backend will auto-seed this administrator on first startup.
# Alternatively, use the /api/v1/auth/setup-admin endpoint.
FIRST_SUPERUSER_EMAIL=admin@your-hospital.com
FIRST_SUPERUSER_PASSWORD=your-secure-admin-password
FIRST_SUPERUSER_NAME=Hospital Administrator
