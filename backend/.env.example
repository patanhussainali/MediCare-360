# MediCare360 Backend Environment Configuration

PROJECT_NAME=MediCare360 Hospital Management Platform
API_V1_STR=/api/v1
ENVIRONMENT=development

# Security
SECRET_KEY=medicare360_super_secure_production_secret_key_change_in_prod_948294
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Default: Local SQLite, switchable to PostgreSQL)
DATABASE_URL=sqlite:///./medicare360.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medicare360

# Redis Cache / Token Blacklist (Optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# Default Master Administrator Seed
FIRST_SUPERUSER_EMAIL=admin@medicare360.com
FIRST_SUPERUSER_PASSWORD=Admin@123
FIRST_SUPERUSER_NAME=Hospital Administrator
